[user]
  name = baua.gonzo
  email = baua.gonzo@gmail.com

[init]
  defaultBranch = main

[color]
  ui = auto

[core]
  editor = vim
  autocrlf = input
  eol = lf
  preloadindex = true
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  line-numbers = true
  # side-by-side = true   # uncomment for two-column; needs a wide terminal

[diff]
  renames = copies
  colorMoved = default

[merge]
  conflictstyle = zdiff3

[pull]
  ff = only

[push]
  autoSetupRemote = true

[fetch]
  prune = true

[rebase]
  autostash = true

[log]
  date = local

[alias]
  # --- log / status ---
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --stat
  s  = status -sb
  last = log -1 HEAD --stat

  # --- navigation ---
  co = checkout
  br = branch

  # --- commit ---
  cm = commit -m
  amend = commit --amend --no-edit

  # --- undo ---
  uncommit = reset --soft HEAD~1
  unstage  = restore --staged

  # --- stash / rebase ---
  pop = stash pop
  mergelast = "!f() { git rebase --interactive HEAD~${1:-2}; }; f"
  cont = "!git rebase --continue"

  # --- identity guard (which author am I committing as?) ---
  whoami = "!git config user.name && git config user.email"

# --- macOS-only settings ---
# Kept out of the main body so this file stays portable to Linux.
# On the M5, your setup script should symlink ~/.gitconfig-macos and
# add this include. On Linux, the file simply won't exist and the
# include is silently skipped.
[include]
  path = ~/.gitconfig-macos
